# Copy to .env and fill in values.
# Vercel: set these in Project Settings → Environment Variables.

# PostgreSQL (Neon): use the POOLED connection string for Vercel / serverless.
# Neon dashboard → Connect → choose "Pooled connection" (host contains `-pooler`).
# Example:
#   postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# The non-pooler host often fails on Vercel build with P1001 (can't reach database).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Finnhub API key for US stock quotes
FINNHUB_API_KEY=""

# Public app URL (used for password reset links)
# Local: http://localhost:3000
# Production: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend (https://resend.com) — password reset emails
# Without RESEND_API_KEY, reset links are logged to the server console only.
RESEND_API_KEY=""
# Testing (no custom domain): Assetra <onboarding@resend.dev> — can only send to your Resend account email
# Production: verify a domain in Resend, then e.g. Assetra <noreply@yourdomain.com>
RESEND_FROM_EMAIL="Assetra <onboarding@resend.dev>"

# OpenAI — AI Agent (Portfolio Advisor)
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=""
# Optional: override the default model (gpt-4o-mini)
AI_AGENT_MODEL="gpt-4o-mini"
