// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AssetType {
  Stock
  ETF
  Crypto
  Cash
}

enum AssetSource {
  MANUAL
  SYNCED
}

enum BrokerConnectionStatus {
  ACTIVE
  ERROR
  DISCONNECTED
}

enum UserActivityType {
  REGISTER
  LOGIN
  DASHBOARD_VIEW
  ASSET_CREATE
  ASSET_UPDATE
  ASSET_DELETE
}

model User {
  id               String    @id @default(cuid())
  username         String?   @unique
  email            String    @unique
  passwordHash     String
  cashAmount       Float     @default(0)
  debtAmount       Float     @default(0)
  realEstateAmount Float     @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastLoginAt      DateTime?
  assets           Asset[]
  groups           AssetGroup[]
  sessions         Session[]
  activities       UserActivity[]
  passwordResetTokens PasswordResetToken[]
  brokerConnections BrokerConnection[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AssetGroup {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  assets    Asset[]

  @@index([userId])
}

model BrokerConnection {
  id              String                 @id @default(cuid())
  userId          String
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId          String                 @unique
  accessTokenEnc  String
  institutionId   String?
  institutionName String?
  status          BrokerConnectionStatus @default(ACTIVE)
  lastSyncedAt    DateTime?
  lastError       String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  assets          Asset[]

  @@index([userId])
}

model Asset {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId      String?
  group        AssetGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  connectionId String?
  connection   BrokerConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  name         String
  symbol       String
  type         AssetType
  source       AssetSource @default(MANUAL)
  externalId   String?
  quantity     Float
  avgCost      Float
  currentPrice Float
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([userId, externalId])
  @@index([userId])
  @@index([groupId])
  @@index([connectionId])
  @@index([userId, source, type])
}

model UserActivity {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      UserActivityType
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

/// Daily OHLCV bars for the portfolio risk engine (shared market data, not per-user).
model DailyMarketPrice {
  id        String   @id @default(cuid())
  symbol    String
  date      DateTime @db.Date
  open      Float?
  high      Float?
  low       Float?
  close     Float
  adjClose  Float?
  volume    BigInt?
  source    String   @default("yahoo")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([symbol, date])
  @@index([symbol, date])
}

/// Derived daily features from DailyMarketPrice (shared, not per-user).
model MarketFeature {
  id            String   @id @default(cuid())
  symbol        String
  date          DateTime @db.Date
  ma20          Float?
  return7d      Float?
  return30d     Float?
  returnYtd     Float?
  return1y      Float?
  volatility7d  Float?
  volatility30d Float?
  volatilityYtd Float?
  volatility1y  Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([symbol, date])
  @@index([symbol, date])
}
