// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AssetType {
  Stock
  ETF
  Crypto
}

enum UserActivityType {
  REGISTER
  LOGIN
  DASHBOARD_VIEW
  ASSET_CREATE
  ASSET_UPDATE
  ASSET_DELETE
}

model User {
  id               String    @id @default(cuid())
  username         String?   @unique
  email            String    @unique
  passwordHash     String
  cashAmount       Float     @default(0)
  debtAmount       Float     @default(0)
  realEstateAmount Float     @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastLoginAt      DateTime?
  assets           Asset[]
  groups           AssetGroup[]
  sessions         Session[]
  activities       UserActivity[]
  passwordResetTokens PasswordResetToken[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AssetGroup {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  assets    Asset[]

  @@index([userId])
}

model Asset {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId      String?
  group        AssetGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  name         String
  symbol       String
  type         AssetType
  quantity     Float
  avgCost      Float
  currentPrice Float
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId])
  @@index([groupId])
}

model UserActivity {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      UserActivityType
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
}
